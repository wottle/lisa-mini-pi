[Unit]
Description=Lisa-style boot launcher (kiosk)
After=systemd-user-sessions.service getty@tty1.service plymouth-quit.service
# Conflicts is bidirectional: starting either of these auto-stops the
# other. That's what makes Q ("quit to desktop", see launcher.py) and
# the desktop's "back to kiosk" icon both work with nothing more than a
# single `systemctl start` of whichever session should now own the
# display - no separate "stop the other one first" step needed.
Conflicts=getty@tty1.service lightdm.service

[Service]
Type=simple
User=wottle
# Xorg needs to switch the VT into graphics mode (xf86OpenConsole), which
# requires a real logind session owning that VT - a bare systemd service
# with no PAM/session context doesn't have that permission, and Xorg
# fails immediately with "Switching VT failed". PAMName+TTYPath makes
# systemd establish a genuine login session for this service (the same
# mechanism a getty normally provides), taking over tty1 instead of
# fighting with the console login prompt that would otherwise be there.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
Environment=DISPLAY=:0
ExecStart=/usr/bin/xinit /home/wottle/lisa-pi-launcher/system/xsession-launcher.sh -- :0 vt1
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
