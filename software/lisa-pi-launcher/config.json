{
  "systems": [
    {
      "id": "lisa",
      "name": "LISA",
      "subtitle": "OFFICE SYSTEM 3.1",
      "icon": "icons/lisa.png",
      "command": ["$HOME/lisa-mini-pi/software/lisa-pi-launcher/lisa-run-with-led.sh", "-k", "-d"]
    },
    {
      "id": "macintosh6",
      "name": "MAC OS 6",
      "subtitle": "SYSTEM 6.0.8",
      "icon": "icons/macintosh6.png",
      "command": ["$HOME/minivmac-final/minivmac", "-r", "$HOME/minivmac-final/MacII.ROM", "$HOME/minivmac-final/System6.image"]
    },
    {
      "id": "macintosh",
      "name": "MAC OS 7",
      "subtitle": "SYSTEM 7.5.3",
      "icon": "icons/macintosh.png",
      "command": ["/usr/bin/BasiliskII"]
    },
    {
      "id": "next",
      "name": "NEXT",
      "subtitle": "NEXTSTEP 3.3",
      "icon": "icons/next.png",
      "command": ["$HOME/lisa-mini-pi/software/lisa-pi-launcher/previous-run-with-led.sh"]
    },
    {
      "id": "apple2",
      "name": "APPLE II",
      "subtitle": "TOTAL REPLAY",
      "icon": "icons/apple2.png",
      "command": ["$HOME/lisa-mini-pi/software/lisa-pi-launcher/linapple-run-with-led.sh", "--hd1", "$HOME/TotalReplay_v6.1.hdv", "--autoboot", "--fullscreen"]
    }
